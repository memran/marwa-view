<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{% block title %}My Themed App (Dark){% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="{{ theme_asset('css/app.css') }}"/>

    <style>
        .theme-fade {
            transition: all .2s ease;
        }
    </style>
</head>
<body class="min-h-full bg-slate-900 text-slate-100 theme-fade">
    <header class="site-header border-b border-slate-700 bg-slate-800 shadow-sm text-slate-100">
        <div class="mx-auto max-w-7xl px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="flex items-center gap-3">
                <img src="{{ theme_asset('images/logo-dark.svg') }}"
                     alt="Logo"
                     class="h-8 w-8 rounded-full ring-1 ring-slate-600 bg-slate-700" />
                <div>
                    <div class="text-sm text-slate-400">Current Theme:</div>
                    <div class="font-semibold text-slate-100">
                        {{ _theme_meta.label }}
                        {% if _theme_previewing %}
                            <span class="rounded bg-amber-400/20 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-200">Preview</span>
                        {% endif %}
                    </div>
                    {% if _theme_meta.description %}
                        <div class="text-xs text-slate-400">{{ _theme_meta.description }}</div>
                    {% endif %}
                    <div class="text-[10px] text-slate-500">
                        Chain: {{ _theme_chain|join(' → ') }}
                    </div>
                </div>
            </div>

            <div class="min-w-[340px] rounded-lg border border-slate-700 bg-slate-900/60 p-3">
                <div class="mb-2 flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Admin Theme Workflow</div>
                        <div class="text-xs text-slate-500">Preview a theme, apply it, or revert to the saved one.</div>
                    </div>
                    {% if _theme_previewing %}
                        <div class="text-[11px] text-amber-200">
                            Saved: <strong>{{ _theme_selected_meta.label }}</strong>
                        </div>
                    {% endif %}
                </div>

                <div class="space-y-2">
                    {% for theme in _theme_catalog %}
                        <form method="post" action="/switch-theme" class="rounded-md border border-slate-700 bg-slate-800 p-3">
                            <input type="hidden" name="theme_name" value="{{ theme.name }}">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <div class="font-semibold text-sm text-slate-100">{{ theme.metadata.label }}</div>
                                    {% if theme.metadata.description %}
                                        <div class="mt-1 text-xs text-slate-400">{{ theme.metadata.description }}</div>
                                    {% endif %}
                                    <div class="mt-2 flex flex-wrap gap-2 text-[10px] text-slate-500">
                                        <span>Key: {{ theme.name }}</span>
                                        {% if theme.metadata.version %}<span>Version: {{ theme.metadata.version }}</span>{% endif %}
                                        {% if theme.metadata.author %}<span>Author: {{ theme.metadata.author }}</span>{% endif %}
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <button type="submit" name="theme_action" value="preview"
                                            class="inline-flex items-center rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/20">
                                        Preview
                                    </button>
                                    <button type="submit" name="theme_action" value="apply"
                                            class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-indigo-500">
                                        Apply
                                    </button>
                                </div>
                            </div>
                        </form>
                    {% endfor %}

                    {% if _theme_previewing %}
                        <form method="post" action="/switch-theme" class="pt-1">
                            <button type="submit" name="theme_action" value="clear-preview"
                                    class="inline-flex items-center rounded-md border border-slate-600 bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-slate-700">
                                Revert Preview
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10">
        {% block content %}{% endblock %}
    </main>

    <footer class="mt-16 border-t border-slate-700 py-6 text-center text-[11px] text-slate-500">
        Powered by Marwa\View + ThemeBuilder
    </footer>

</body>
</html>
