{% extends "layouts/base.twig" %}

{% block title %}{{ title }} - {{ appName }}{% endblock %}

{% block body %}
  <main class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-10">
    <section class="rounded-[2rem] border border-white/10 bg-slate-900/70 p-8 shadow-glow backdrop-blur sm:p-10">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-2xl">
          <div class="inline-flex rounded-full border border-brand-400/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">
            Developer Friendly Example
          </div>
          <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">{{ title }}</h1>
          <p class="mt-4 text-lg leading-8 text-slate-300">
            Hello, <span class="font-semibold text-white">{{ user.name }}</span>. This example keeps the template readable while still looking presentable enough for real project demos.
          </p>
        </div>

        <div class="min-w-[240px] rounded-3xl border border-white/10 bg-white/5 p-5">
          <div class="text-xs uppercase tracking-[0.24em] text-slate-400">Account</div>
          <div class="mt-3 text-2xl font-bold text-white">{{ user.role|title }}</div>
          <p class="mt-2 text-sm leading-6 text-slate-300">Shared globals and regular view data render into the same template without extra ceremony.</p>
        </div>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.7fr_1fr]">
        <div class="rounded-3xl border border-white/10 bg-white/6 p-6">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-semibold text-white">Notifications</h2>
            <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">{{ notifications|length }} active</span>
          </div>
          <ul class="mt-5 space-y-3">
            {% for note in notifications %}
              <li class="rounded-2xl border border-white/8 bg-slate-950/50 px-4 py-3 text-sm text-slate-300">{{ note }}</li>
            {% else %}
              <li class="rounded-2xl border border-dashed border-white/10 px-4 py-5 text-sm text-slate-500">No new notifications.</li>
            {% endfor %}
          </ul>
        </div>

        <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-6">
          <div class="text-xs uppercase tracking-[0.24em] text-slate-500">Template Notes</div>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-300">
            <li>Extends a shared layout.</li>
            <li>Uses plain Twig syntax with Marwa\View globals.</li>
            <li>Stays framework-template focused instead of exposing Twig internals.</li>
          </ul>
        </div>
      </div>

      {{ view('components/footer')|raw }}
    </section>
  </main>
{% endblock %}
