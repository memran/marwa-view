{
  "name": "memran/marwa-view",
  "description": "A thin, developer-friendly PSR-compliant View Engine built on top of Twig with PSR-16 caching. Part of the MarwaPHP ecosystem.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammad Emran",
      "email": "emran@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "twig/twig": "^3.21",
    "psr/simple-cache": "^3.0",
    "symfony/translation": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "Marwa\\View\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marwa\\View\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.88",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/var-dumper": "^7.0"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:coverage": "phpunit --configuration phpunit.xml.dist --coverage-text",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist --no-progress --debug --memory-limit=512M",
    "lint": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose --sequential",
    "fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose --sequential",
    "ci": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "keywords": [
    "twig",
    "view-engine",
    "psr-16",
    "template",
    "marwa",
    "php8",
    "dx",
    "cache"
  ],
  "support": {
    "issues": "https://github.com/memran/marwa-view/issues",
    "source": "https://github.com/memran/marwa-view"
  }
}
